 #pragma config(Sensor, port1,  sensorSonar,    sensorVexIQ_Distance)
#pragma config(Motor,  motor1,          motorSoco,     tmotorVexIQ, openLoop, encoder)
#pragma config(Motor,  motor2,          motorEsquerdo, tmotorVexIQ, PIDControl, driveLeft, encoder)
#pragma config(Motor,  motor3,          motorDireito,  tmotorVexIQ, PIDControl, driveRight, encoder)
//*!!Code automatically generated by 'ROBOTC' configuration wizard               !!//

//define a distancia do alvo, + o tempo necessario 
#define DISTANCIA_ALVO x
#define TEMPO_SOCO y

//funcao para acionar o mecanismo do soco
void dispararSoco()
{
	//lanca o soco
	motor[motorSoco] = 100;
	wait1Msec(TEMPO_SOCO); 

	//recolhe o mecanismo
	motor[motorSoco] = -100;
	wait1Msec(TEMPO_SOCO);
}

void estrategiaInicial()
{
	 motor[motorEsquerdo] = 100;
    motor[motorDireito] = 100;
    wait1Msec (500);
    motor[motorEsquerdo] = 100;
    motor[motorDireito]  = 60;
    wait1Msec(500);
    motor[motorEsquerdo] = 100;
    motor[motorDireito] = 100;
    wait1Msec(500);
    motor[motorEsquerdo] = 60;
    motor[motorDireito] = 100;
    wait1Msec(500);
}

task main()
{
	wait1Msec(5000);
  
	estrategiaInicial();
 
	//encontrar oponente
	motor[motorEsquerdo] = 50;
	motor[motorDireito] = -50;
	      while (SensorValue[sensorSonar] > DISTANCIA_ALVO)
	           {
		           wait1Msec(20 );
	           }
	motor[motorEsquerdo] = 0;
	motor[motorDireito] = 0;
	wait1Msec(100);

	//movimentaï¿½ao de combate
	while (true)
	{
		if (SensorValue[sensorSonar] <= DISTANCIA_ALVO)
		{
			motor[motorEsquerdo] = 0;
			motor[motorDireito] = 0;
			dispararSoco();
		}
		else
	  {
		    motor[motorEsquerdo] = 40;
        motor[motorDireito] = -40;
    }
     wait1Msec(20);
   }
}
